{
  "ConnectionStrings": {
    "Vela": "Host=localhost;Database=vela;Username=vela_user;Password=vela_dev"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http.Resilience": "Fatal",
        "System": "Warning",
        "Polly": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vela-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "XTrades": {
    "PageSize": 50,
    "DateSpec": "Today",
    "OrderBy": "TimeOfEntryAlertEpoch desc"
  },
  "RiskEngine": {
    "TradingPaused": false,
    "MinXScore": 100,
    "MinStockPriceDollars": 3.00,
    "ApprovedTraders": [
    ],
    "RestrictedTraders": {
      "Tim": 0,
      "Sean@BearishBull": 0,
      "tancorman": 0,
      "Skep": 0,
      "Paltrader SPY scalps": 0
    },
    "SpyglassOnlyMode": true,
    "AllowOptions": false,
    "AllowLotto": false,
    "AllowHigh": false,
    "MaxDailyExposurePct": 100.0,
    "AlertStalenessMaxSlippagePct": 25.0,
    "StockAlertStalenessMaxSlippagePct": 2.0,
    "MarginPct": 10.0,
    "MaxPositionsPerSymbol": 2,
    "MaxOptionsPositionsPerSymbol": 1,
    "MaxStockPositionsPerSymbol": 1,
    "OptionsInitialBudget": 1000,
    "OptionsAverageBudget": 250,
    "OptionsMaxBudget": 2000,
    "OptionsHighBudget": 750,
    "OptionsHighAverageBudget": 0,
    "OptionsLottoBudget": 500,
    "OptionsLottoAverageBudget": 0,
    "OptionsStandardTrailPct": 20.0,
    "HighSlippageTrailPct": 15.0,
    "OptionsHighTrailPct": 40.0,
    "OptionsLottoTrailPct": 50.0,
    "OptionsStandardMaxSlippagePct": 15,
    "OptionsHighMaxSlippagePct": 15,
    "OptionsTargetMultiple": 3.0,
    "OptionCloseThresholdPct": 50.0,
    "OptionPartialCloseRatio": 0.5,
    "StockInitialBudget": 5000,
    "StockAverageBudget": 1500,
    "StockMaxBudget": 6000,
    "StockDailyAllocationPct": 100.0,
    "StockTargetMultiple": 1.5,
    "StockStandardTrailPct": 5.0,
    "StockHighTrailPct": 10.0,
    "StockLottoTrailPct": 15.0,
    "StockMaxSlippagePct": 15,
    "ZeroDteEntryCutoffHour": 12,
    "SameDayExpiryAutoCloseCutoff": "15:30",
    "BlockedSymbols": ["NDX","RUT","VIX","DJX","NQ","ES","MES","MNQ","YM","RTY",
